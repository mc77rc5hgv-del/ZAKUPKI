RTS_BASE_URL=https://krd-market.rts-tender.ru
RTS_HEADLESS=false
RTS_PROFILE_DIR=.rts-profile
RTS_DOWNLOAD_DIR=downloads
RTS_SNAPSHOT_DIR=.rts-snapshots
RTS_TIMEOUT_MS=30000
RTS_NAVIGATION_RETRIES=3
RTS_ALLOW_WRITES=false
RTS_ACCOUNT_OWNER_ID=123456789
# Keep false on Railway. Account login is allowed only on a trusted local host by default.
RTS_ALLOW_CLOUD_ACCOUNT_SESSION=false
# Optional proxy for hosts whose data-center IP is rejected by RTS Anti-DDoS
RTS_PROXY_SERVER=
RTS_PROXY_USERNAME=
RTS_PROXY_PASSWORD=

# Telegram bot
TELEGRAM_BOT_TOKEN=
TELEGRAM_ALLOWED_USERS=123456789
TELEGRAM_ADMIN_USERS=123456789
BOT_DATA_DIR=.bot-data
MONITOR_INTERVAL_MINUTES=15
MINIAPP_URL=
MINIAPP_PORT=3000
MINIAPP_DEV_BYPASS=false
TELEGRAM_AUTH_MAX_AGE_SECONDS=86400
MCP_COMMAND=node
MCP_ARGS=dist/entrypoints/mcp.js

# Optional AI tender analysis
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.4
