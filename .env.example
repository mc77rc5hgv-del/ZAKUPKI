RTS_BASE_URL=https://krd-market.rts-tender.ru
RTS_HEADLESS=false
RTS_PROFILE_DIR=.rts-profile
RTS_ALLOW_PROFILE_DELETION=false
RTS_DOWNLOAD_DIR=downloads
RTS_SNAPSHOT_DIR=.rts-snapshots
RTS_TIMEOUT_MS=30000
RTS_NAVIGATION_RETRIES=3
# Circuit breaker: after this many consecutive navigation failures, stop
# retrying and fail fast for the cooldown period instead of hammering a down portal.
RTS_CIRCUIT_THRESHOLD=5
RTS_CIRCUIT_COOLDOWN_MS=60000
# Max time (ms) a single MCP tool call may wait in the shared browser-page queue.
RTS_QUEUE_TIMEOUT_MS=120000
RTS_ALLOW_WRITES=false
RTS_ACCOUNT_OWNER_ID=123456789
# Keep false on Railway. Account login is allowed only on a trusted local host by default.
RTS_ALLOW_CLOUD_ACCOUNT_SESSION=false
# Optional proxy for hosts whose data-center IP is rejected by RTS Anti-DDoS
RTS_PROXY_SERVER=
RTS_PROXY_USERNAME=
RTS_PROXY_PASSWORD=

# Local agent / Railway<->local bridge
# On Railway: set RTS_TRANSPORT=hub so the web/bot process relays RTS calls over
# the authenticated WebSocket channel to a paired local agent instead of
# spawning Chromium in the cloud. Leave unset ("local") on a single machine and
# on the local agent process itself.
RTS_TRANSPORT=local
# Local agent only: address of the deployed Mini App/hub (falls back to MINIAPP_URL).
AGENT_HUB_URL=
# Local agent only: where this machine's paired device identity is stored.
RTS_DEVICE_DIR=.rts-device

# At-rest encryption for BOT_DATA_DIR (bot.json, devices.json). Leave empty to
# keep today's plaintext files; once set, stores are transparently migrated to
# AES-256-GCM on their next write (a .bak-<timestamp> copy of the plaintext is
# kept once). Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Rotating or losing this key makes existing encrypted data unreadable — back it up
# separately from BOT_DATA_DIR, and never commit it.
DATA_ENCRYPTION_KEY=

# Telegram bot
TELEGRAM_BOT_TOKEN=
TELEGRAM_ALLOWED_USERS=123456789
TELEGRAM_ADMIN_USERS=123456789
BOT_DATA_DIR=.bot-data
MONITOR_INTERVAL_MINUTES=15
MINIAPP_URL=
MINIAPP_PORT=3000
MINIAPP_DEV_BYPASS=false
TELEGRAM_AUTH_MAX_AGE_SECONDS=86400
MCP_COMMAND=node
MCP_ARGS=dist/entrypoints/mcp.js

# Optional AI tender analysis
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.4
